{
  "name": "experience_search",
  "description": "检索类似问题的成功经验，用于AI决策参考",
  "category": "memory",
  "parameters": {
    "problem_type": {
      "type": "string",
      "description": "问题类型: fitness_low, turnover_high, sharpe_low, correlation_fail, weight_concentration"
    },
    "metrics": {
      "type": "object",
      "description": "指标范围，用于精确匹配",
      "properties": {
        "fitness_min": {"type": "number"},
        "fitness_max": {"type": "number"},
        "turnover_min": {"type": "number"},
        "turnover_max": {"type": "number"},
        "sharpe_min": {"type": "number"}
      }
    },
    "limit": {
      "type": "integer",
      "description": "返回数量限制，默认5",
      "default": 5
    }
  },
  "output": {
    "success": "boolean",
    "experiences": [
      {
        "id": "string",
        "timestamp": "string",
        "problem": "object",
        "action": "object",
        "result": "object",
        "similarity_score": "number"
      }
    ],
    "total_count": "integer",
    "success_rate": "number"
  },
  "examples": [
    "检索: experience_search(problem_type='fitness_low', metrics={fitness_max:0.5})",
    "检索: experience_search(problem_type='turnover_high', metrics={turnover_min:70})"
  ],
  "cli_command": "wq-experience",
  "cli_usage": "wq-experience --search --problem fitness_low --limit 5"
}