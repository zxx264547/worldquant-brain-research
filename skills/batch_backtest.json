{
  "name": "batch_backtest",
  "description": "批量回测多个Alpha表达式，支持并发控制",
  "category": "backtest",
  "parameters": {
    "ideas_file": {
      "type": "string",
      "required": true,
      "description": "Ideas文件路径(JSON格式)"
    },
    "concurrent": {
      "type": "integer",
      "default": 5,
      "description": "并发数"
    }
  },
  "output": {
    "success": "boolean",
    "results": "array"
  },
  "examples": [
    "批量回测: batch_backtest(ideas_file='ideas.json')",
    "批量: batch_backtest(ideas_file='ideas.json', concurrent=3)"
  ],
  "cli_command": "wq-batch-backtest",
  "cli_usage": "wq-batch-backtest --ideas ideas.json --concurrent 5"
}
