{
  "name": "experience_record",
  "description": "记录优化经验到本地知识库，用于后续检索和学习",
  "category": "memory",
  "parameters": {
    "problem": {
      "type": "object",
      "description": "问题描述",
      "properties": {
        "type": {"type": "string", "description": "问题类型: fitness_low, turnover_high, sharpe_low, correlation_fail"},
        "fitness": {"type": "number"},
        "turnover": {"type": "number"},
        "sharpe": {"type": "number"},
        "expression": {"type": "string"}
      },
      "required": true
    },
    "action": {
      "type": "object",
      "description": "执行的操作",
      "properties": {
        "type": {"type": "string", "description": "操作类型: expression_modify, settings_adjust, field_change, dataset_change"},
        "details": {"type": "string", "description": "具体操作描述"},
        "settings": {"type": "object", "description": "参数设置"}
      },
      "required": true
    },
    "result": {
      "type": "object",
      "description": "结果",
      "properties": {
        "sharpe_before": {"type": "number"},
        "sharpe_after": {"type": "number"},
        "fitness_before": {"type": "number"},
        "fitness_after": {"type": "number"},
        "turnover_before": {"type": "number"},
        "turnover_after": {"type": "number"},
        "success": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "required": true
    }
  },
  "output": {
    "success": "boolean",
    "experience_id": "string",
    "message": "string"
  },
  "examples": [
    "记录: experience_record(problem={type:'fitness_low', fitness:0.3}, action={type:'expression_modify', details:'group_rank+ts_backfill'}, result={fitness_after:0.6, success:true})"
  ],
  "cli_command": "wq-experience",
  "cli_usage": "wq-experience --record --problem fitness_low --action group_rank --result success"
}