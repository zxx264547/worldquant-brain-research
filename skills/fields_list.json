  "category": "brain_api",
  "parameters": {
    "dataset_id": {
      "type": "string",
      "required": true,
      "description": "数据集ID，如 TOP1500, analyst4, pv87"
    }
  },
  "output": {
    "success": "boolean",
    "dataset": "string",
    "fields": "array",
    "count": "integer"
