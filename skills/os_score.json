{
  "name": "os_score",
  "description": "计算Alpha的OS预期表现评分（续航力评分）",
  "category": "alpha_analysis",
  "parameters": {
    "alpha_id": {
      "type": "string",
      "description": "Alpha ID（可选）"
    },
    "pnl": {
      "type": "array",
      "description": "PnL序列（可选）"
    }
  },
  "output": {
    "success": "boolean",
    "total_score": "number",
    "label": "string"
  },
  "examples": [
    "计算: os_score(alpha_id='ALPHA123')",
    "计算: os_score(pnl=[0.1, 0.2, 0.15])"
  ],
  "cli_command": "wq-os-score",
  "cli_usage": "wq-os-score --alpha-id ALPHA123"
}
