{
  "name": "alpha_configs_test",
  "description": "测试多个Alpha配置参数组合，找到最优配置",
  "category": "backtest",
  "parameters": {
    "configs_file": {
      "type": "string",
      "required": true,
      "description": "配置文件路径(JSON)，包含expression和settings"
    }
  },
  "output": {
    "success": "boolean",
    "results": "array"
  },
  "examples": [
    "测试配置: alpha_configs_test(configs_file='configs.json')"
  ],
  "cli_command": "wq-alpha-configs-test",
  "cli_usage": "wq-alpha-configs-test --configs configs.json"
}
